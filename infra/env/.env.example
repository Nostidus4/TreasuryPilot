# Safe local-only defaults. Copy this file to infra/env/.env.
# Replace provider placeholders locally and keep real values out of Git.
POSTGRES_DB=treasurypilot
POSTGRES_USER=treasurypilot
POSTGRES_PASSWORD=local-development-only
MINIO_ROOT_USER=treasurypilot
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET=treasurypilot-local
ANTHROPIC_API_KEY=
# Optional secondary LLM provider (Claude on Amazon Bedrock, AGT-017). Empty disables failover.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
# Optional: use a dedicated least-privilege role; never reuse the core database credential.
AI_DATABASE_URL=
# Core worker only. Never expose these values to worker-ai.
TP_ATTESTATION_PRIVATE_KEY=
TP_SIGNER_SHARED_SECRET=
TP_CORS_ORIGINS=http://localhost:5173
VITE_WALLETCONNECT_ID=
