# Safe local-only defaults. Copy this file to infra/env/.env.
# Replace provider placeholders locally and keep real values out of Git.
POSTGRES_DB=treasurypilot
POSTGRES_USER=treasurypilot
POSTGRES_PASSWORD=local-development-only
MINIO_ROOT_USER=treasurypilot
MINIO_ROOT_PASSWORD=local-development-only
MINIO_BUCKET=treasurypilot-local
ANTHROPIC_API_KEY=
# Optional secondary LLM provider (Claude on Amazon Bedrock, AGT-017). Empty disables failover.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
# Optional hosted Postgres (Supabase project flbztxutuqtbxjoflxsi); used only with
# `-f infra/compose.yaml -f infra/compose.supabase.yaml`. Use the SESSION pooler (port 5432) or the
# direct connection, never the transaction pooler (6543: breaks asyncpg prepared statements).
# `ssl=require` is mandatory (Supabase needs TLS). URL-encode special characters in the password.
# SUPABASE_DATABASE_URL=postgresql+asyncpg://postgres.flbztxutuqtbxjoflxsi:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?ssl=require
# Sepolia (opt-in; `-f infra/compose.yaml -f infra/compose.sepolia.yaml`).
# Backend RPC (worker/signer), server-side only. Alchemy: https://eth-sepolia.g.alchemy.com/v2/<ALCHEMY_API_KEY>
# SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Browser RPC, inlined into the public web bundle: never put a secret key here. Use a public RPC
# or a separate Alchemy key restricted to the app's domain (Alchemy dashboard → app → Allowlist).
# SEPOLIA_WEB_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Optional: use a dedicated least-privilege role; never reuse the core database credential.
AI_DATABASE_URL=
# Core worker only. Never expose these values to worker-ai.
# Host paths to the encrypted policy keystore (eth keystore JSON) and its password file.
TP_POLICY_KEYSTORE_FILE=
TP_POLICY_KEYSTORE_PASSWORD_FILE=
TP_SIGNER_SHARED_SECRET=
# Optional tracing: http://jaeger:4318 with `--profile observability`. Empty disables export.
OTEL_EXPORTER_OTLP_ENDPOINT=
TP_CORS_ORIGINS=http://localhost:5173
# Optional error tracking (OBS-003): one Sentry project per service; empty disables reporting.
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
SENTRY_DSN_SIGNER=
VITE_SENTRY_DSN=
# Optional: unhandled errors also ping this Telegram chat. Needs the service's Sentry DSN above;
# not wired into worker-ai.
TP_TELEGRAM_BOT_TOKEN=
TP_TELEGRAM_ALERT_CHAT_ID=
VITE_WALLETCONNECT_ID=
