{$APP_DOMAIN:localhost} {
  encode zstd gzip

  handle_path /api/* {
    reverse_proxy api:8000
  }

  handle {
    reverse_proxy web:80
  }
}

# MinIO for browser presigned reads only. The host must match S3_PUBLIC_ENDPOINT_URL because it is
# part of the signature; Caddy forwards Host unchanged. Needs its own DNS A record.
files.{$APP_DOMAIN:localhost} {
  reverse_proxy minio:9000
}
