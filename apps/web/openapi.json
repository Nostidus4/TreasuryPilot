{
  "components": {
    "schemas": {
      "CreateOrganizationRequest": {
        "properties": {
          "country": {
            "anyOf": [
              {
                "maxLength": 2,
                "minLength": 2,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "displayTz": {
            "default": "UTC",
            "maxLength": 64,
            "minLength": 1,
            "title": "Displaytz",
            "type": "string"
          },
          "legalName": {
            "anyOf": [
              {
                "maxLength": 300,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legalname"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["name"],
        "title": "CreateOrganizationRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["status", "service", "version"],
        "title": "HealthResponse",
        "type": "object"
      },
      "MagicLinkRequest": {
        "properties": {
          "email": {
            "maxLength": 320,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email"],
        "title": "MagicLinkRequest",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipView"
            },
            "title": "Memberships",
            "type": "array"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          },
          "wallets": {
            "items": {
              "$ref": "#/components/schemas/WalletView"
            },
            "title": "Wallets",
            "type": "array"
          }
        },
        "required": ["user", "memberships", "wallets"],
        "title": "MeResponse",
        "type": "object"
      },
      "MembershipView": {
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "orgId": {
            "format": "uuid",
            "title": "Orgid",
            "type": "string"
          },
          "roles": {
            "items": {
              "type": "string"
            },
            "title": "Roles",
            "type": "array"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["id", "orgId", "roles", "status"],
        "title": "MembershipView",
        "type": "object"
      },
      "OrganizationChecklist": {
        "properties": {
          "memberCount": {
            "title": "Membercount",
            "type": "integer"
          },
          "moduleEnabled": {
            "title": "Moduleenabled",
            "type": "boolean"
          },
          "treasuryCreated": {
            "title": "Treasurycreated",
            "type": "boolean"
          },
          "walletLinked": {
            "title": "Walletlinked",
            "type": "boolean"
          }
        },
        "required": [
          "memberCount",
          "walletLinked",
          "treasuryCreated",
          "moduleEnabled"
        ],
        "title": "OrganizationChecklist",
        "type": "object"
      },
      "OrganizationDetailsResponse": {
        "properties": {
          "checklist": {
            "$ref": "#/components/schemas/OrganizationChecklist"
          },
          "org": {
            "$ref": "#/components/schemas/OrganizationView"
          }
        },
        "required": ["org", "checklist"],
        "title": "OrganizationDetailsResponse",
        "type": "object"
      },
      "OrganizationResponse": {
        "properties": {
          "org": {
            "$ref": "#/components/schemas/OrganizationView"
          }
        },
        "required": ["org"],
        "title": "OrganizationResponse",
        "type": "object"
      },
      "OrganizationSettingsRequest": {
        "properties": {
          "autoMatch": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Automatch"
          },
          "soloMode": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Solomode"
          }
        },
        "title": "OrganizationSettingsRequest",
        "type": "object"
      },
      "OrganizationView": {
        "properties": {
          "autoMatch": {
            "title": "Automatch",
            "type": "boolean"
          },
          "country": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Country"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "displayTz": {
            "title": "Displaytz",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "legalName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Legalname"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "soloMode": {
            "title": "Solomode",
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "legalName",
          "country",
          "displayTz",
          "soloMode",
          "autoMatch",
          "createdAt"
        ],
        "title": "OrganizationView",
        "type": "object"
      },
      "UserView": {
        "properties": {
          "displayName": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Displayname"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": ["id", "email", "displayName", "status"],
        "title": "UserView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifyMagicLinkRequest": {
        "properties": {
          "token": {
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token"],
        "title": "VerifyMagicLinkRequest",
        "type": "object"
      },
      "VerifyMagicLinkResponse": {
        "properties": {
          "csrfToken": {
            "title": "Csrftoken",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserView"
          }
        },
        "required": ["user", "csrfToken"],
        "title": "VerifyMagicLinkResponse",
        "type": "object"
      },
      "WalletView": {
        "properties": {
          "address": {
            "title": "Address",
            "type": "string"
          },
          "chainFamily": {
            "title": "Chainfamily",
            "type": "string"
          },
          "isContract": {
            "title": "Iscontract",
            "type": "boolean"
          },
          "linkedAt": {
            "format": "date-time",
            "title": "Linkedat",
            "type": "string"
          }
        },
        "required": ["address", "chainFamily", "isContract", "linkedAt"],
        "title": "WalletView",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Human-authorized, policy-enforced treasury operations.",
    "title": "TreasuryPilot API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": ["system"]
      }
    },
    "/v1/auth/logout": {
      "post": {
        "operationId": "logout_v1_auth_logout_post",
        "responses": {
