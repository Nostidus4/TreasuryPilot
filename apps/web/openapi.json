    "/v1/orgs/{organization_id}/settings": {
      "patch": {
        "operationId": "update_organization_settings_v1_orgs__organization_id__settings_patch",
        "parameters": [
          {
            "in": "path",
            "name": "organization_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Organization Id",
