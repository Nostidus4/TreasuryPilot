{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "eslint.config.js",
    "postcss.config.js",
    "tailwind.config.ts",
    "playwright.config.ts",
    "playwright.stack.config.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "e2e-stack/**/*.ts",
    "src/mocks/seeded.ts"
  ]
}
