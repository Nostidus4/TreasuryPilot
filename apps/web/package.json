    "@tanstack/react-query": "^5.66.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "i18next": "^26.4.3",
    "lucide-react": "^0.468.0",
    "openapi-fetch": "^0.14.0",
    "radix-ui": "^1.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-dropzone": "^20.1.3",
