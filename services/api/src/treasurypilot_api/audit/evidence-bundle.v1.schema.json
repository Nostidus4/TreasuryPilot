{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://treasurypilot.dev/schemas/evidence-bundle.v1.schema.json",
  "title": "TreasuryPilot evidence bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "organizationId", "request", "flags", "validations", "aiCalls", "operations", "verifications", "coverage", "fixtureLabels", "generatedAt", "appVersion", "sha256"],
  "properties": {
    "schemaVersion": {"const": "evidence-bundle.v1"},
    "status": {"const": "VALID"},
    "organizationId": {"type": "string", "format": "uuid"},
    "request": {"$ref": "#/$defs/request"},
    "approval": {"$ref": "#/$defs/approval"},
    "flags": {"type": "array", "items": {"$ref": "#/$defs/flag"}},
    "plan": {"$ref": "#/$defs/plan"},
    "validations": {"type": "array", "items": {"$ref": "#/$defs/validation"}},
    "aiCalls": {"type": "array", "items": {"$ref": "#/$defs/aiCall"}},
    "attestation": {"$ref": "#/$defs/approval"},
    "operations": {"type": "array", "items": {"type": "object", "propertyNames": {"pattern": "^(?!(email|Email|EMAIL|phone|Phone|PHONE|telephone|Telephone|contact|Contact|CONTACT|contactName|ContactName|contact_name|Contact_name|contactEmail|ContactEmail|contact_email|Contact_email|rawSignature|RawSignature|raw_signature|signature|Signature|signature_bytes|Signature_bytes|sig|Sig)$).+$"}}},
    "transactions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/transaction"}},
    "verifications": {"type": "array", "items": {"$ref": "#/$defs/verification"}},
    "reconciliation": {"$ref": "#/$defs/reconciliation"},
    "easUid": {"type": "string"},
    "easUrl": {"type": "string", "format": "uri"},
    "coverage": {"type": "object"},
    "fixtureLabels": {"type": "array", "items": {"type": "string"}},
    "generatedAt": {"type": "string", "format": "date-time"},
    "appVersion": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "amount", "currency"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "vendorDisplayName": {"type": ["string", "null"]},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "currency": {"type": "string"},
        "fingerprint": {"type": ["string", "null"]},
        "invoiceHash": {"type": ["string", "null"]}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "typedData": {"type": ["object", "null"], "propertyNames": {"pattern": "^(?!(email|Email|EMAIL|phone|Phone|PHONE|telephone|Telephone|contact|Contact|CONTACT|contactName|ContactName|contact_name|Contact_name|contactEmail|ContactEmail|contact_email|Contact_email|rawSignature|RawSignature|raw_signature|signature|Signature|signature_bytes|Signature_bytes|sig|Sig)$).+$"}},
        "signerAddress": {"type": ["string", "null"]},
        "signatureHash": {"type": ["string", "null"], "pattern": "^(0x)?[0-9a-fA-F]{64}$"}
      }
    },
    "flag": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "code", "severity", "status"],
      "properties": {
        "id": {"type": "string", "format": "uuid"}, "code": {"type": "string"},
        "severity": {"type": "string"}, "status": {"type": "string"},
        "acknowledgedBy": {"type": ["string", "null"]},
        "acknowledgedAt": {"type": ["string", "null"], "format": "date-time"},
        "ackNote": {"type": ["string", "null"]}
      }
    },
    "planStep": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "stepId", "action", "chainId", "fromAddress", "toAddress", "assetAddress", "amount"],
      "properties": {
        "seq": {"type": "integer", "minimum": 0}, "stepId": {"type": "string"}, "action": {"type": "integer"},
        "chainId": {"type": "integer", "minimum": 1}, "fromAddress": {"type": "string"},
        "toAddress": {"type": "string"}, "assetAddress": {"type": "string"},
        "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "venue": {"type": "string", "enum": ["TEST_ROUTER", "SIGNED_QUOTE"]}
      }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": ["plannerSource", "steps"],
      "properties": {
        "planId": {"type": ["string", "null"], "format": "uuid"}, "status": {"type": ["string", "null"]},
        "plannerSource": {"type": "string"}, "planHash": {"type": ["string", "null"]},
        "steps": {"type": "array", "items": {"$ref": "#/$defs/planStep"}}
      }
    },
    "reconciliationLine": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "txHash", "amount"],
      "properties": {
        "classification": {"type": "string"}, "txHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"},
        "assetAddress": {"type": ["string", "null"]}, "amount": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"},
        "blockNumber": {"type": ["integer", "null"], "minimum": 0}, "day": {"type": ["string", "null"], "format": "date"}
      }
    },
    "reconciliation": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "version", "lines"],
      "properties": {
        "status": {"type": "string"}, "version": {"type": "integer"}, "matchedBy": {"type": ["string", "null"]},
        "matchedAt": {"type": ["string", "null"], "format": "date-time"},
        "finalizedAt": {"type": ["string", "null"], "format": "date-time"},
        "lines": {"type": "array", "items": {"$ref": "#/$defs/reconciliationLine"}}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "decision", "reasonCodes", "checks"],
      "properties": {"id": {"type": ["string", "null"], "format": "uuid"}, "planId": {"type": ["string", "null"], "format": "uuid"}, "stage": {"type": "string"}, "decision": {"type": "string"}, "reasonCodes": {"type": "array", "items": {"type": "string"}}, "checks": {"type": "array", "items": {"type": "object", "propertyNames": {"pattern": "^(?!(email|Email|EMAIL|phone|Phone|PHONE|telephone|Telephone|contact|Contact|CONTACT|contactName|ContactName|contact_name|Contact_name|contactEmail|ContactEmail|contact_email|Contact_email|rawSignature|RawSignature|raw_signature|signature|Signature|signature_bytes|Signature_bytes|sig|Sig)$).+$"}}}}
    },
    "aiCall": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "purpose"],
      "properties": {"id": {"type": "string", "format": "uuid"}, "purpose": {"type": "string"}, "model": {"type": ["string", "null"]}, "promptVersion": {"type": ["string", "null"]}, "outputSummary": {"type": ["string", "null"]}}
    },
    "transaction": {
      "type": "object", "additionalProperties": false,
      "required": ["txHash", "chainId"],
      "properties": {"txHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}, "chainId": {"type": "integer", "minimum": 1}, "blockNumber": {"type": ["integer", "null"], "minimum": 0}, "feeBaseUnits": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)$"}}
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": ["txHash", "status", "checkedAt", "details"],
      "properties": {"txHash": {"type": "string", "pattern": "^0x[0-9a-f]{64}$"}, "status": {"type": "string"}, "checkedAt": {"type": "string", "format": "date-time"}, "details": {"type": "object", "propertyNames": {"pattern": "^(?!(email|Email|EMAIL|phone|Phone|PHONE|telephone|Telephone|contact|Contact|CONTACT|contactName|ContactName|contact_name|Contact_name|contactEmail|ContactEmail|contact_email|Contact_email|rawSignature|RawSignature|raw_signature|signature|Signature|signature_bytes|Signature_bytes|sig|Sig)$).+$"}}}
    }
  }
}
